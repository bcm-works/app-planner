{
  "nodeModulesDir": "none",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "deploy": {
    "org": "murty",
    "app": "app-personal-planner",
    "install": "deno task install",
    "build": "deno task build",
    "runtime": {
      "mode": "dynamic",
      "entrypoint": "_fresh/server.js",
      "args": ["--unstable-kv"]
    }
  },
  "imports": {
    "@/": "./src/",
    "@/server.tsx": "./src/server.tsx",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server",
    "@fresh/core": "jsr:@fresh/core@^2.3.3",
    "fresh/internal": "jsr:@fresh/core@^2.3.3/internal",
    "preact": "npm:preact@^10.29.1"
  },
  "tasks": {
    "install": {
      "description": "Install third-party dependencies.",
      "command": "deno install --quiet"
    },
    "build": {
      "description": "Build optimised assets for production.",
      "command": "deno run --allow-all dev.ts build",
      "dependencies": ["install"]
    },
    "update": {
      "description": "Update third-party dependencies.",
      "command": "deno outdated --update --compatible"
    },
    "deps": {
      "description": "Update all dependencies and commit the results.",
      "command": "deno task update && git add deno.json deno.lock && git commit -m \"Update third-party dependencies\" || true"
    },
    "setup": {
      "description": "Initial environment setup.",
      "command": "deno task install && [ ! -f .env ] && cp .sample.env .env"
    },
    "check": {
      "description": "Run Deno code check tools.",
      "command": "deno lint && deno fmt && deno check"
    },
    "test": {
      "description": "Run all tests and show test coverage",
      "command": "deno test --quiet --allow-all --unstable-kv --clean --coverage=coverage --coverage-threshold=85 src",
      "dependencies": ["install"]
    },
    "serve": {
      "description": "Start the web server.",
      "command": "deno run --allow-all --env-file=.env --unstable-kv src/server.tsx"
    },
    "list": {
      "description": "List all available commands.",
      "command": "deno task"
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "fmt": {
    "include": [
      "src/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      "src/",
      "deno.json"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "permissions": {},
  "allowScripts": {
    "allow": [],
    "deny": []
  },
  "exclude": [
    ".claude/",
    ".zed/",
    "dev.ts",
    "docs/",
    "node_modules/",
    "coverage/",
    ".env"
  ]
}
