{
  "nodeModulesDir": "none",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "@/": "./src/",
    "@/server.tsx": "./src/server.tsx",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server",
    "@fresh/core": "jsr:@fresh/core@^2.3.3",
    "fresh/internal": "jsr:@fresh/core@^2.3.3/internal",
    "preact": "npm:preact@^10.29.8"
  },
  "tasks": {
    "install": {
      "description": "Install Deno dependencies.",
      "command": "deno install --quiet"
    },
    "build": {
      "description": "Build optimised assets for production.",
      "command": "echo 'ERROR not implemented'"
    },
    "deps": {
      "description": "Update Deno dependencies.",
      "command": "deno outdated --update --compatible"
    },
    "setup": {
      "description": "Initial environment setup.",
      "command": "bash ./bin/setup.sh"
    },
    "test": {
      "description": "Run tests and code checks.",
      "command": "bash ./bin/test.sh",
    },
    "start": {
      "description": "Start the server.",
      "command": "bash ./bin/start.sh"
    },
    "list": {
      "description": "List all available commands.",
      "command": "deno task"
    }
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "fmt": {
    "include": [
      "src/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      "src/",
      "deno.json"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "permissions": {},
  "allowScripts": {
    "allow": [],
    "deny": []
  },
  "exclude": [
    ".claude/",
    ".zed/",
    "dev.ts",
    "docs/",
    "node_modules/",
    "coverage/",
    ".env"
  ]
}